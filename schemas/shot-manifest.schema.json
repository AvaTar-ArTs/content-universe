{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avatararts.org/schemas/content-universe/shot-manifest.schema.json",
  "title": "Content Universe Shot Manifest",
  "type": "object",
  "required": ["shot_manifest_id", "workflow_run_id", "cue_map_id", "shots", "review_status"],
  "properties": {
    "shot_manifest_id": {"type": "string", "minLength": 1},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "cue_map_id": {"type": "string", "minLength": 1},
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shot_id", "scene_id", "cue_ids", "start_seconds", "end_seconds"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "scene_id": {"type": "string", "minLength": 1},
          "cue_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "framing": {"type": ["string", "null"]},
          "camera": {"type": ["string", "null"]},
          "action": {"type": ["string", "null"]},
          "emotion": {"type": ["string", "null"]},
          "location": {"type": ["string", "null"]},
          "prompt_manifest_id": {"type": ["string", "null"]},
          "scene_graph_id": {"type": ["string", "null"]},
          "references": {"type": "array", "items": {"type": "object"}},
          "protected_fields": {"type": "object"},
          "render_requirements": {"type": "object"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "output_requirements": {"type": "object"},
    "review_status": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
